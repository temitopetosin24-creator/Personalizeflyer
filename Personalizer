<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>QHSES Alumni Flyer Personalizer</title>
<style>
:root{--yellow:#ffd400;--ink:#111;--muted:#5c5c5c}*{box-sizing:border-box}body{margin:0;background:#f4f4f4;color:var(--ink);font-family:Arial,Helvetica,sans-serif}.top{background:#101010;color:#fff;padding:22px 16px;text-align:center;border-bottom:5px solid var(--yellow)}.top h1{font-size:clamp(21px,4vw,32px);margin:0 0 7px}.top p{margin:0;color:#ddd;font-size:14px}.wrap{max-width:1100px;margin:24px auto;padding:0 16px;display:grid;grid-template-columns:minmax(270px,360px) minmax(0,1fr);gap:24px;align-items:start}.panel,.preview{background:#fff;border-radius:16px;padding:20px;box-shadow:0 4px 18px #0000000d}.panel h2{font-size:19px;margin:0 0 18px}.field{margin-bottom:18px}.field label{display:block;font-weight:700;font-size:14px;margin-bottom:8px}.field input[type=text],.field input[type=file]{width:100%;font:inherit;padding:12px;border:1px solid #ccc;border-radius:9px;background:#fff}.hint{font-size:12px;color:var(--muted);line-height:1.5;margin:7px 0 0}.buttons{display:grid;gap:10px;margin-top:20px}.controls{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field input[type=range]{accent-color:var(--ink);cursor:pointer}.canvas-wrap canvas{touch-action:pan-y;cursor:default}.canvas-wrap canvas.photo-mode{cursor:grab}.canvas-wrap canvas.photo-mode:active{cursor:grabbing}.secondary:focus-visible,.primary:focus-visible{outline:3px solid #555;outline-offset:3px}button:disabled{opacity:.55;cursor:not-allowed}@media(max-width:760px){.wrap{grid-template-columns:1fr;margin:14px auto;gap:14px}.panel,.preview{padding:16px}.preview{order:2}.panel{order:1}.top{padding:18px 12px}}button{border:0;border-radius:10px;padding:14px 16px;font-size:15px;font-weight:700;cursor:pointer}.primary{background:var(--yellow);color:#111}.secondary{background:#eee;color:#111}.preview-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}.preview-head h2{font-size:19px;margin:0}.preview-head span{font-size:12px;color:#666}.canvas-wrap{width:100%;background:#eee;border-radius:10px;overflow:hidden;line-height:0}.canvas-wrap canvas{display:block;width:100%;height:auto}.status{font-size:13px;color:#333;line-height:1.5;margin:12px 0 0}.footer{text-align:center;color:#777;font-size:12px;padding:0 16px 24px}
@media(max-width:760px){.wrap{grid-template-columns:1fr;margin:16px auto;gap:16px}.preview{grid-row:1}.panel{grid-row:2}.panel,.preview{padding:16px}}
</style></head><body>
<header class="top"><h1>Personalize Your QHSES Alumni Flyer</h1><p>Add your photo and name, then download your own flyer.</p></header>
<main class="wrap">
<section class="panel"><h2>Your flyer details</h2>
<div class="field"><label for="personName">Your name</label><input id="personName" type="text" maxlength="38" placeholder="Enter your full name" autocomplete="name" aria-describedby="nameHint"><p class="hint" id="nameHint">Use the name you want displayed on the flyer. Long names automatically shrink to fit.</p></div>
<div class="field"><label for="personPhoto">Upload your picture</label><input id="personPhoto" type="file" accept="image/*"><p class="hint">A clear portrait photo works best. Your photo is processed in this browser and is not uploaded to a server.</p></div>
<div class="field"><label for="photoPosition">Adjust photo framing</label><input id="photoPosition" type="range" min="1" max="3" step="0.01" value="1" style="width:100%"><p class="hint">Zoom: <output id="zoomValue">100%</output>. Drag your photo inside the preview to reposition it. The initial framing starts at the top.</p><div class="controls"><button class="secondary" id="resetPhotoBtn" type="button">Reset photo position</button><button class="secondary" id="shareBtn" type="button">Share flyer</button></div></div>
<div class="buttons"><button class="primary" id="downloadBtn">Download personalized JPEG</button><button class="secondary" id="resetBtn" type="button">Start over</button></div>
<p class="status" id="status" aria-live="polite">Your personalized flyer preview will appear on the right.</p>
</section>
<section class="preview"><div class="preview-head"><h2>Live preview</h2><span>High-quality JPEG</span></div><div class="canvas-wrap"><canvas id="flyerCanvas" width="1536" height="1536"></canvas></div></section>
</main><div class="footer">QHSES Leadership Academy Alumni · Safety on the Street 3.0</div>
<script>
const BASE_IMAGE = 'data:image/png;base64,';

const canvas=document.getElementById('flyerCanvas'),ctx=canvas.getContext('2d');
const nameInput=document.getElementById('personName'),photoInput=document.getElementById('personPhoto'),zoomInput=document.getElementById('photoPosition'),statusEl=document.getElementById('status');
const zoomValue=document.getElementById('zoomValue'),resetPhotoBtn=document.getElementById('resetPhotoBtn'),shareBtn=document.getElementById('shareBtn');
const base=new Image();base.src=BASE_IMAGE;let userPhoto=null,photoOffsetX=0,photoOffsetY=0,dragging=false,lastPointer=null;const S=canvas.width/1248;
const photoBox={x:822,y:507,w:365,h:381};
function fitText(text,maxWidth,startSize,minSize){let size=startSize;ctx.font=`900 ${size}px Arial, Helvetica, sans-serif`;while(ctx.measureText(text).width>maxWidth&&size>minSize){size--;ctx.font=`900 ${size}px Arial, Helvetica, sans-serif`;}return size;}
function drawCover(image,x,y,w,h,zoom=1,offsetX=0,offsetY=0){const iw=image.naturalWidth||image.width,ih=image.naturalHeight||image.height;const scale=Math.max(w/iw,h/ih)*zoom;const sw=w/scale,sh=h/scale;const maxX=Math.max(0,iw-sw),maxY=Math.max(0,ih-sh);const sx=maxX/2+offsetX*maxX;const sy=offsetY*maxY;ctx.save();ctx.beginPath();ctx.rect(x,y,w,h);ctx.clip();ctx.drawImage(image,sx,sy,sw,sh,x,y,w,h);ctx.restore();}
function draw(){if(!base.complete||!base.naturalWidth)return;ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.scale(S,S);ctx.drawImage(base,0,0,1248,1248);
const {x:px,y:py,w:pw,h:ph}=photoBox;
if(userPhoto){drawCover(userPhoto,px,py,pw,ph,Number(zoomInput.value),photoOffsetX,photoOffsetY);canvas.classList.add('photo-mode');}
else{canvas.classList.remove('photo-mode');const placeholder=ctx.createLinearGradient(px,py,px+pw,py+ph);placeholder.addColorStop(0,'#252525');placeholder.addColorStop(1,'#101010');ctx.fillStyle=placeholder;ctx.fillRect(px,py,pw,ph);ctx.fillStyle='#ffd400';ctx.beginPath();ctx.arc(px+pw/2,py+126,48,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.moveTo(px+pw/2-91,py+287);ctx.quadraticCurveTo(px+pw/2-82,py+207,px+pw/2,py+207);ctx.quadraticCurveTo(px+pw/2+82,py+207,px+pw/2+91,py+287);ctx.closePath();ctx.fill();ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='middle';ctx.font='700 18px Arial, Helvetica, sans-serif';ctx.fillText('UPLOAD YOUR PHOTO',px+pw/2,py+331);}
// Preserve the original yellow nameplate and surrounding flyer artwork.
ctx.save();ctx.beginPath();ctx.moveTo(804,887);ctx.lineTo(1178,887);ctx.lineTo(1203,975);ctx.lineTo(804,975);ctx.closePath();ctx.fillStyle='#ffd400';ctx.fill();ctx.strokeStyle='#ffdf00';ctx.lineWidth=2;ctx.stroke();
const name=(nameInput.value.trim()||'YOUR NAME').replace(/[<>]/g,'');const maxW=350;const fontSize=fitText(name,maxW,32,13);ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle='#090909';ctx.font=`900 ${fontSize}px Arial, Helvetica, sans-serif`;ctx.fillText(name,1002,923,maxW);ctx.restore();ctx.setTransform(1,0,0,1,0,0);zoomValue.textContent=Math.round(Number(zoomInput.value)*100)+'%';}
function resetPhoto(){photoOffsetX=0;photoOffsetY=0;zoomInput.value='1';draw();}
base.onload=draw;nameInput.addEventListener('input',draw);zoomInput.addEventListener('input',draw);
photoInput.addEventListener('change',()=>{const file=photoInput.files&&photoInput.files[0];if(!file)return;if(!file.type.startsWith('image/')){statusEl.textContent='Please choose an image file.';photoInput.value='';return;}if(file.size>15*1024*1024){statusEl.textContent='Please choose a photo smaller than 15 MB.';photoInput.value='';return;}const reader=new FileReader();reader.onload=()=>{const im=new Image();im.onload=()=>{userPhoto=im;resetPhoto();statusEl.textContent=(im.naturalWidth<600||im.naturalHeight<600?'Photo added, but a higher-resolution image may look sharper. ':'Photo added. Drag it in the preview to adjust the crop.')+'Your photo stays on this device.';};im.onerror=()=>statusEl.textContent='Could not read that picture. Try another image.';im.src=reader.result;};reader.onerror=()=>statusEl.textContent='Could not read that file. Please try again.';reader.readAsDataURL(file);});
function pointerPosition(e){const r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*1248,y:(e.clientY-r.top)/r.height*1248};}
canvas.addEventListener('pointerdown',e=>{if(!userPhoto)return;const p=pointerPosition(e);if(p.x<photoBox.x||p.x>photoBox.x+photoBox.w||p.y<photoBox.y||p.y>photoBox.y+photoBox.h)return;dragging=true;lastPointer=p;canvas.setPointerCapture(e.pointerId);e.preventDefault();});
canvas.addEventListener('pointermove',e=>{if(!dragging||!userPhoto)return;const p=pointerPosition(e);const zoom=Number(zoomInput.value);const iw=userPhoto.naturalWidth,ih=userPhoto.naturalHeight;const scale=Math.max(photoBox.w/iw,photoBox.h/ih)*zoom;const maxX=Math.max(1,iw-photoBox.w/scale),maxY=Math.max(1,ih-photoBox.h/scale);photoOffsetX=Math.max(0,Math.min(1,photoOffsetX-(p.x-lastPointer.x)/photoBox.w*photoBox.w/scale/maxX));photoOffsetY=Math.max(0,Math.min(1,photoOffsetY-(p.y-lastPointer.y)/photoBox.h*photoBox.h/scale/maxY));lastPointer=p;draw();});
canvas.addEventListener('pointerup',()=>dragging=false);canvas.addEventListener('pointercancel',()=>dragging=false);resetPhotoBtn.addEventListener('click',resetPhoto);
function makeJpeg(){return new Promise(resolve=>{draw();canvas.toBlob(resolve,'image/jpeg',0.96);});}
function safeName(){return(nameInput.value.trim()||'QHSES-Alumni').replace(/[^a-z0-9_-]+/gi,'_').replace(/^_+|_+$/g,'')||'Flyer';}
function trackAnalytics(event){fetch(`/api/${event}`,{method:'POST',keepalive:true}).catch(()=>{});}
function trackNamedFlyer(){if(nameInput.value.trim())trackAnalytics('personalized');}
trackAnalytics('visit');
document.getElementById('downloadBtn').addEventListener('click',async()=>{if(!base.complete||!base.naturalWidth){statusEl.textContent='Please wait for the flyer to load.';return;}const blob=await makeJpeg();if(!blob){statusEl.textContent='Could not create the JPEG. Please try again.';return;}trackNamedFlyer();const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`QHSES_Alumni_${safeName()}.jpg`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);statusEl.textContent='Your high-quality JPEG is ready. Your photo was processed locally.';});
shareBtn.addEventListener('click',async()=>{if(!base.complete||!base.naturalWidth){statusEl.textContent='Please wait for the flyer to load.';return;}const blob=await makeJpeg();if(!blob){statusEl.textContent='Could not create the image. Please download it instead.';return;}trackNamedFlyer();const file=new File([blob],`QHSES_Alumni_${safeName()}.jpg`,{type:'image/jpeg'});try{if(navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({files:[file],title:'My QHSES Alumni Flyer',text:'Join me for QHSES Leadership Academy Alumni — Safety on the Street 3.0.'});statusEl.textContent='Share options opened.';}else{const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=file.name;a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);statusEl.textContent='Image sharing is not supported in this browser, so the JPEG was downloaded for you to share.';}}catch(err){if(err.name!=='AbortError')statusEl.textContent='Sharing was unavailable. Use Download personalized JPEG instead.';}});
document.getElementById('resetBtn').addEventListener('click',()=>{nameInput.value='';photoInput.value='';zoomInput.value='1';userPhoto=null;photoOffsetX=0;photoOffsetY=0;draw();statusEl.textContent='Reset complete. Add your name and upload a photo to personalize the flyer.';});
</script></body></html>